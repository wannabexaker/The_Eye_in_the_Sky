# The one .env for this project. Copy to .env next to the compose file and fill
# in the values; docker compose loads it automatically. Never commit .env.
# On the deploy host keep it mode 600 (scripts/deploy-pi.sh enforces this).

# --- Database (docker-compose.yml for local dev, docker-compose.prod.yml) ---
POSTGRES_PASSWORD="__SET_POSTGRES_PASSWORD__"
POSTGRES_PORT="5432"

# --- Production only (docker-compose.prod.yml) -------------------------------
# Image tag to run (vX.Y.Z). scripts/deploy-pi.sh sets it; unset = latest.
EYE_VERSION=""

# Long random string; keys session and password-reset token hashes.
# Changing it signs every player out.
AUTH_COOKIE_SECRET="__SET_A_LONG_RANDOM_SECRET__"

# "true" behind HTTPS when cookies must work cross-site (iframe embedding).
COOKIE_SECURE="false"

# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3100,http://localhost:3200"

# Cloudflare Turnstile on registration. Both set (same widget) or both empty.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Feature flags (all off by default; see docs/OPERATOR_GUIDE.md).
PROVABLY_FAIR_ENABLED="false"
RG_TOOLS_ENABLED="false"
SWAGGER_ENABLED="false"
METRICS_ENABLED="false"
