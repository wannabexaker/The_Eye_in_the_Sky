{
  "name": "the-eye-in-the-sky",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.6.3",
  "scripts": {
    "dev": "corepack pnpm --filter player-web dev",
    "dev:player": "corepack pnpm --filter player-web dev",
    "dev:player:clean": "corepack pnpm --filter player-web dev:clean",
    "dev:admin": "corepack pnpm --filter admin-web dev",
    "predev:api": "corepack pnpm --filter @eye/game-engine build",
    "dev:api": "corepack pnpm --filter api start:dev",
    "dev:apps": "corepack pnpm --filter player-web --filter admin-web --parallel dev",
    "dev:all": "corepack pnpm --filter api --filter player-web --filter admin-web --parallel dev",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose stop postgres",
    "db:setup": "corepack pnpm --filter api prisma:generate && corepack pnpm --filter api exec prisma migrate deploy && corepack pnpm --filter api prisma:seed",
    "db:reset": "docker compose down -v postgres && corepack pnpm db:up && corepack pnpm db:setup",
    "predev:full": "corepack pnpm --filter @eye/game-engine build",
    "dev:full": "corepack pnpm db:up && corepack pnpm db:setup && corepack pnpm dev:all",
    "build": "corepack pnpm -r build",
    "build:player:clean": "corepack pnpm --filter player-web build:clean",
    "lint": "corepack pnpm -r lint",
    "optimize:assets": "corepack pnpm --filter player-web optimize:assets",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "simulate": "corepack pnpm --filter @eye/game-engine simulate",
    "par-report": "corepack pnpm --filter @eye/game-engine par-report"
  },
  "pnpm": {
    "overrides": {
      "path-to-regexp@8": ">=8.4.0",
      "lodash@4": ">=4.18.0",
      "@xmldom/xmldom": ">=0.9.12",
      "proxy-addr": ">=2.0.8",
      "js-yaml@4": ">=4.3.2",
      "nanoid@3": ">=3.3.18",
      "postcss": ">=8.5.18",
      "source-map-js": ">=1.2.2",
      "sharp": ">=0.35.5"
    }
  }
}
